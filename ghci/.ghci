-- :set prompt "λ > "
-- you can add the loaded modules into prompt using %s
:set prompt "\ESC[1;32mλ > \ESC[0m"
:set prompt-cont "\ESC[1;34mλ | \ESC[0m"
-- :set -interactive-print=Text.Pretty.Simple.pPrint
:set +m
:set -fdefer-type-errors
:set -fno-warn-deferred-type-errors 
:def hoogle \s -> return $ ":! hoogle " ++ s
:def hinfo \s -> return $ ":! hoogle --info " ++ s

-- import Data.Map as Map
import Data.List
import Data.Char

:set -fdiagnostics-color=always
