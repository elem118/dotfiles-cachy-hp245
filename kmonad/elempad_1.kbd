(defcfg
  ;; For linux
  input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink "My KMonad output"
    ;; to understand the importance of the following line, see the section on
    ;; Compose-key sequences at the near-bottom of this file.
    "sleep 1 && setxkbmap -option compose:ralt")
  cmp-seq ralt    ;; Set the compose key to `rightAlt'
  cmp-seq-delay 0 ;; 5ms delay between each compose-key sequence press
  key-seq-delay 0 ;; 5ms delay between each outputted key event

  ;; Comment this if you want unhandled events not to be emitted
  fallthrough false

  ;; Set this to false to disable any command-execution in KMonad
  allow-cmd true

  ;; Set the implicit around to `around`
  implicit-around around
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  ins  prnt del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc home
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \    pgup
  caps a    s    d    f    g    h    j    k    l    ;    '    ret       pgdn
  lsft z    x    c    v    b    n    m    ,    .    /    rsft           end
  lctl fn   lmet   lalt           spc            ralt rctl
)

(defalias 
  ct_es (tap-next-release esc lctl)
  tab_met (tap-next-release tab lmet)
  ;; to_tl (layer-toggle tl)
  to_tl (sticky-key 500 (layer-toggle tl))
  to_tr (sticky-key 500 (layer-toggle tr))
  to_br (sticky-key 500 (layer-toggle br))
)

(deflayer bl
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  ins  prnt del
  lsft      XX   @to_tr @to_br  @to_tl   XX   XX   @to_tl   @to_br  @to_tr XX  XX  XX  XX  home  
  @tab_met  q    w    e    r    t    y    u    i    o    p    XX   XX   XX  pgup
  @ct_es    a    s    d    f    g    h    j    k    l    ;    XX    ret     pgdn
  bspc      z    x    c    v    b    n    m    ,    XX   XX    rsft         end
  lctl      fn   lmet lalt           spc            ralt rctl
)

(deflayer tl
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  ins  prnt del
  lsft      XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX  home  
  @tab_met  S-q  S-w  S-e  S-r  S-t  S-y  S-u  S-i  S-o  S-p  XX   XX   XX  pgup
  @ct_es    S-a  S-s  S-d  S-f  S-g  S-h  S-j  S-k  S-l  S-;  XX   ret      pgdn
  bspc      S-z  S-x  S-c  S-v  S-b  S-n  S-m  S-,  XX   XX   rsft          end
  lctl      fn   lmet lalt           spc            ralt rctl
)

(deflayer br
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  ins  prnt del
  lsft      XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX  home  
  @tab_met  1    2    3    4    5    6    7    8    9    0    XX   XX   XX  pgup
  @ct_es    XX   XX   XX   XX   [    ]    XX   XX   XX   '    XX    ret     pgdn
  bspc      -    =    \\   `    XX   XX   /    .    XX   XX    rsft         end
  lctl      fn   lmet lalt           spc            ralt rctl
)

(deflayer tr
  esc       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  ins  prnt del
  lsft      XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX  home  
  @tab_met  S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  XX   XX   XX  pgup
  @ct_es    XX   XX   XX   XX   S-[  S-]  XX   XX   XX   S-'  XX   ret      pgdn
  bspc      S--  S-=  S-\\ S-`  XX   XX   S-/  S-.  XX   XX    rsft         end
  lctl      fn   lmet lalt           spc            ralt rctl
)

